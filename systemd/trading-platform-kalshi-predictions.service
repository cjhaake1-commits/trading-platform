[Unit]
Description=Kalshi Predictions Demo high-frequency scanner and execution gate
After=trading-platform-kalshi-research.service

[Service]
Type=simple
WorkingDirectory=/home/cjhaake1/trading-platform
EnvironmentFile=/home/cjhaake1/.config/trading-platform/kalshi-demo-execution.env
Environment=KALSHI_ENGINE=predictions
Environment=PAPER_STRESS_MODE=true
Environment=LIVE_TRADING_ENABLED=false
Environment=KALSHI_LIVE_TRADING_ENABLED=false
ExecStart=/bin/bash -lc 'while true; do /home/cjhaake1/trading-platform/.venv/bin/python scripts/kalshi_execution_cycle.py; sleep 5; done'
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
