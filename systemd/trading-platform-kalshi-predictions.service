[Unit]
Description=Kalshi Predictions Demo scanner and execution gate
After=trading-platform-kalshi-research.service

[Service]
Type=simple
WorkingDirectory=/home/cjhaake1/trading-platform
EnvironmentFile=/home/cjhaake1/.config/trading-platform/kalshi-demo-execution.env
Environment=KALSHI_ENGINE=predictions
ExecStart=/bin/bash -lc 'while true; do /home/cjhaake1/trading-platform/.venv/bin/python scripts/kalshi_execution_cycle.py; sleep 60; done'
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
