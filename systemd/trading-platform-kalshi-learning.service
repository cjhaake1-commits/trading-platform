[Unit]
Description=Trading Platform Kalshi durable learning cycle
After=trading-platform-kalshi-research.service

[Service]
Type=simple
WorkingDirectory=/home/cjhaake1/trading-platform
EnvironmentFile=/home/cjhaake1/.config/trading-platform/kalshi-research.env
Environment=KALSHI_RESEARCH_DB=var/kalshi/research.db
Environment=KALSHI_LEARNING_STATUS=var/global-intelligence/learning-status.json
ExecStart=/home/cjhaake1/trading-platform/.venv/bin/python scripts/kalshi_learning_cycle.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
