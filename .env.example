# Market / alternative data provider credentials
# Copy this file to .env on the VM. Never commit real keys.

# Alpaca paper Trading API
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Optional override; free stock streaming normally uses the IEX feed.
ALPACA_MARKETDATA_STREAM_URL=

# OANDA fxTrade Practice API
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
# Optional override; defaults to https://stream-fxpractice.oanda.com
OANDA_PRACTICE_STREAM_URL=

# Kalshi event-intelligence foundation (disabled; Demo/read-only only)
KALSHI_ENABLED=false
KALSHI_TRADING_ENABLED=false
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PAPER_CAPITAL=0

# Saxo OpenAPI simulation only (live endpoints prohibited; never commit a token)
SAXO_ENV=sim
SAXO_ACCESS_TOKEN=
SAXO_CLIENT_ID=
SAXO_REDIRECT_URI=http://localhost/saxo-oauth
# Optional safety settings; values may only tighten the global risk limit.
SAXO_MAX_RISK_PER_TRADE_PCT=0.0125
SAXO_MIN_CASH_RESERVE_PCT=0.10

# Alpaca metals/commodities pillar (same paper credentials; live is prohibited)
ALPACA_ENV=paper
METALS_MAX_RISK_PER_TRADE_PCT=0.0125
METALS_MIN_CASH_RESERVE_PCT=0.10

# Quiver Quantitative API key
QUIVER_API_KEY=

# Licensed Bloomberg research data. Disabled until an authorized Bloomberg
# subscription/enterprise agreement and applicable exchange entitlements exist.
# Desktop API (DAPI) normally runs on an authorized Windows Bloomberg Terminal
# host. The Linux VM requires licensed SAPI/B-PIPE; do not tunnel or scrape a
# Terminal session in violation of Bloomberg/data-vendor terms.
BLOOMBERG_ENABLED=false
BLOOMBERG_LICENSE_ACK=false
BLOOMBERG_RESEARCH_ONLY=true
BLOOMBERG_MODE=auto
BLOOMBERG_HOST=127.0.0.1
BLOOMBERG_PORT=8194
BLOOMBERG_CONNECT_TIMEOUT_MS=5000
BLOOMBERG_REFERENCE_DATA_SERVICE=//blp/refdata
BLOOMBERG_MARKET_DATA_SERVICE=//blp/mktdata
BLOOMBERG_AUTH_OPTIONS=
BLOOMBERG_APPLICATION_NAME=

# Paper benchmark-readiness gate. These thresholds only determine whether a
# separate live-capital review may begin. They never enable live trading.
LIVE_READINESS_MIN_PAPER_DAYS=126
LIVE_READINESS_MIN_COMPLETED_TRADES=100
LIVE_READINESS_MIN_MARKET_REGIMES=3
LIVE_READINESS_MIN_DATA_COVERAGE=0.95
LIVE_READINESS_MIN_BENCHMARK_OUTPERFORMANCE=0.70
LIVE_READINESS_MIN_ROLLING_OUTPERFORMANCE=0.70
LIVE_READINESS_MIN_ROLLING_WINDOWS=12
LIVE_READINESS_MAX_DRAWDOWN=0.20
LIVE_READINESS_MAX_DRAWDOWN_DISADVANTAGE=0.05

# Live trading remains disabled by default.
LIVE_TRADING_ENABLED=false
PAPER_EXPERIMENT_MODE=false
MICRO_TRADING_EXPERIMENT_MODE=false
SHORT_EXPERIMENT_MODE=false
DERIVATIVES_RESEARCH_MODE=false
ARBITRAGE_RESEARCH_MODE=false
# Autonomous simulated execution has an independent, explicit local arm.
AUTONOMOUS_TRADING_ENABLED=false
