[Unit]
Description=Kalshi Demo read-only reconciliation
After=trading-platform-kalshi-research.service

[Service]
Type=simple
WorkingDirectory=/home/cjhaake/trading-platform
EnvironmentFile=/home/cjhaake/.config/trading-platform/kalshi-demo-execution.env
Environment=KALSHI_ENGINE=reconciliation
ExecStart=/bin/bash -lc 'while true; do /home/cjhaake/trading-platform/.venv/bin/python scripts/kalshi_execution_cycle.py; sleep 120; done'
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
