[Unit]
Description=Trading Platform lawful public research collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cjhaake/trading-platform
Environment=PYTHONPATH=/home/cjhaake/trading-platform/src
Environment=PUBLIC_RESEARCH_MACRO_URL=https://api.frankfurter.app/latest
Environment=PUBLIC_RESEARCH_GITHUB_URL=https://api.github.com/search/repositories?q=quantitative+finance&sort=stars&per_page=10
ExecStart=/bin/bash -lc 'while true; do /home/cjhaake/trading-platform/.venv/bin/python scripts/public_research_cycle.py; sleep 900; done'
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=default.target
